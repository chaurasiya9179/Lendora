{
  "name": "@lendora/api",
  "version": "1.0.0",
  "description": "REST API Backend for Lendora Loan Management & Customer CRM Platform",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "prebuild": "npm --prefix ../../packages/shared-types run build && npm --prefix ../../packages/validation run build && npm --prefix ../../packages/financial-engine run build",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@lendora/financial-engine": "*",
    "@lendora/shared-types": "*",
    "@lendora/validation": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
